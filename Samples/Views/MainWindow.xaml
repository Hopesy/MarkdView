<Window x:Class="Samples.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Samples.Views" xmlns:markd="clr-namespace:MarkdView.Controls;assembly=MarkdView"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="MarkdView 示例 - MVVM 模式" Width="900"
        Height="600" Background="{DynamicResource Markdown.Background}"
        Foreground="{DynamicResource Markdown.Foreground}" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 主题切换工具栏 - 使用命令绑定 -->
        <StackPanel Margin="8" Background="{DynamicResource Markdown.Toolbar.Background}" Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"
                       Text="主题切换 (MVVM)：" />
            <Button Margin="3" Padding="8,4"
                    Command="{Binding SwitchToLightThemeCommand}"
                    Content="浅色主题" />
            <Button Margin="3" Padding="8,4"
                    Command="{Binding SwitchToDarkThemeCommand}"
                    Content="深色主题" />
            <Separator Margin="8,0" />
            <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" FontWeight="Bold"
                       Text="字体大小：" />
            <Button Margin="2" Padding="8,5" Click="SetFontSize10_Click"
                    Content="10" />
            <Button Margin="2" Padding="8,5" Click="SetFontSize12_Click"
                    Content="12" />
            <Button Margin="2" Padding="8,5" Click="SetFontSize14_Click"
                    Content="14" />
            <Button Margin="2" Padding="8,5" Click="SetFontSize16_Click"
                    Content="16" />
            <Button Margin="2" Padding="8,5" Click="SetFontSize20_Click"
                    Content="20" />
            <Separator Margin="10,0" />
            <Button Margin="3" Padding="8,4" Click="OpenScrollViewerTest_Click"
                    Content="ScrollViewer 测试" />
            <Button Margin="3" Padding="8,4" Click="OpenMarkdownListTest_Click"
                    Content="📝 列表渲染测试" />
        </StackPanel>
        <!-- MarkdView 控件 - 主题由全局 ThemeManager 控制 -->
        <markd:MarkdownViewer x:Name="MarkdownViewer" Grid.Row="1" Margin="10"
                              Content="{Binding Content}"
                              EnableSyntaxHighlighting="True" FontSize="12" Theme="Auto"
                              UseTransparentCanvas="False" />
    </Grid>
</Window>
