<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 基础颜色 -->
    <SolidColorBrush x:Key="Markdown.Foreground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="Markdown.Background" Color="#1A1B1D" />
    <SolidColorBrush x:Key="Markdown.Bold.Foreground" Color="#4C63EB" />
    <Thickness x:Key="Markdown.PagePadding">18,14,18,16</Thickness>
    <Thickness x:Key="Markdown.Heading.BorderThickness">0,0,0,1</Thickness>
    <!-- 标题 -->
    <SolidColorBrush x:Key="Markdown.Heading.H1.Foreground" Color="#F4F6FB" />
    <SolidColorBrush x:Key="Markdown.Heading.H1.Border" Color="#4C63EB" />
    <SolidColorBrush x:Key="Markdown.Heading.H2.Foreground" Color="#DCE1EA" />
    <SolidColorBrush x:Key="Markdown.Heading.H2.Border" Color="#343842" />
    <!-- 引用块 -->
    <SolidColorBrush x:Key="Markdown.Quote.Background" Color="#23252A" />
    <SolidColorBrush x:Key="Markdown.Quote.Border" Color="#4C63EB" />
    <SolidColorBrush x:Key="Markdown.Quote.Foreground" Color="#D5DAE4" />
    <Thickness x:Key="Markdown.Quote.BorderThickness">3,0,0,0</Thickness>
    <Thickness x:Key="Markdown.Quote.Padding">14,10,14,10</Thickness>
    <!-- 内联代码 -->
    <SolidColorBrush x:Key="Markdown.InlineCode.Background" Color="#2A2D36" />
    <SolidColorBrush x:Key="Markdown.InlineCode.Foreground" Color="#D7DEFF" />
    <SolidColorBrush x:Key="Markdown.InlineCode.Border" Color="#3D4250" />
    <Thickness x:Key="Markdown.InlineCode.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Markdown.InlineCode.CornerRadius">4</CornerRadius>
    <!-- 链接 -->
    <SolidColorBrush x:Key="Markdown.Link.Foreground" Color="#4C63EB" />
    <!-- 代码块 -->
    <SolidColorBrush x:Key="Markdown.CodeBlock.Background" Color="#1A2230" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.Border" Color="#30363D" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.Header.Background" Color="#161B22" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.Language.Foreground" Color="#8B949E" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.Background" Color="#21262D" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.Foreground" Color="#C9D1D9" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.Border" Color="#30363D" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.HoverBackground" Color="#30363D" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.HoverBorder" Color="#8B949E" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.CopyButton.PressedBackground" Color="#161B22" />
    <SolidColorBrush x:Key="Markdown.CodeBlock.Foreground" Color="#C9D1D9" />
    <!-- 语法高亮 -->
    <SolidColorBrush x:Key="Markdown.Syntax.Default" Color="#C9D1D9" />
    <SolidColorBrush x:Key="Markdown.Syntax.Comment" Color="#8B949E" />
    <SolidColorBrush x:Key="Markdown.Syntax.String" Color="#A5D6FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.Attribute" Color="#D2A8FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.ControlKeyword" Color="#FF7B72" />
    <SolidColorBrush x:Key="Markdown.Syntax.DeclarationKeyword" Color="#FF7B72" />
    <SolidColorBrush x:Key="Markdown.Syntax.TypeKeyword" Color="#79C0FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.Literal" Color="#79C0FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.Type" Color="#FFA657" />
    <SolidColorBrush x:Key="Markdown.Syntax.Function" Color="#D2A8FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.Number" Color="#79C0FF" />
    <SolidColorBrush x:Key="Markdown.Syntax.ShellCommand" Color="#7EE787" />
    <!-- 其他 -->
    <SolidColorBrush x:Key="Markdown.Table.Background" Color="#0D1117" />
    <SolidColorBrush x:Key="Markdown.Table.Border" Color="#30363D" />
    <SolidColorBrush x:Key="Markdown.Table.Header.Background" Color="#161B22" />
    <SolidColorBrush x:Key="Markdown.Table.Header.Foreground" Color="#C9D1D9" />
    <SolidColorBrush x:Key="Markdown.Table.Row.Background" Color="#0D1117" />
    <SolidColorBrush x:Key="Markdown.HorizontalRule.Border" Color="#3A3F4B" />
    <Thickness x:Key="Markdown.HorizontalRule.Margin">0,18,0,18</Thickness>
    <Thickness x:Key="Markdown.HorizontalRule.BorderThickness">0,1,0,0</Thickness>
    <SolidColorBrush x:Key="Markdown.Image.Background" Color="Transparent" /> +
    <SolidColorBrush x:Key="Markdown.Image.Border" Color="#3B404C" />
    <Thickness x:Key="Markdown.Image.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Markdown.Image.CornerRadius">8</CornerRadius>
    <FontFamily x:Key="Markdown.CodeFontFamily">Cascadia Code,Consolas,Segoe UI Mono</FontFamily>
</ResourceDictionary>
